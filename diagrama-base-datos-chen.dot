// Diagrama Chen del esquema cafebar_mvc. No contiene registros ni contraseñas.
// Renderizar con: dot -Tsvg diagrama-base-datos-chen.dot -o diagrama-base-datos-chen.svg
graph Chen {
  graph [layout=dot, rankdir=LR, nodesep=0.3, ranksep=0.8, overlap=prism, splines=true, sep="+18", pad=0.5, start=27, outputorder=edgesfirst, bgcolor="white"];
